# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/vu-web

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=90d

# CORS — your frontend domain(s). Comma-separated list is supported.
# Include every origin that should be allowed: your Heroku/Vercel frontend + http://localhost:3000 for dev.
# Example: https://vu-web-front.herokuapp.com,http://localhost:3000
# If left empty (local dev with no value), all origins are allowed.
CLIENT_URL=https://your-frontend.herokuapp.com,http://localhost:3000

# Cloudflare R2 Storage (S3-compatible)
# NOTE: these exact variable names are read by src/config/r2.js:
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_ENDPOINT, R2_PUBLIC_BASE_URL
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# DigitalOcean GenAI (Serverless Inference)
DOAI_API_KEY=doo_v1_your_api_key
DOAI_BASE_URL=https://inference.do-ai.run/v1
DOAI_MODEL=deepseek-4-flash
DOAI_MAX_TOKENS=6000

# On-demand frontend revalidation (optional but recommended).
# After a blog/news post is published or deleted, the backend pings the
# frontend's /api/revalidate endpoint so /sitemap.xml, /blog, and /news
# refresh immediately. Both must be set together, or the ping is skipped.
# FRONTEND_URL must match the deployed frontend origin (no trailing slash).
# REVALIDATE_SECRET must match the frontend's REVALIDATE_SECRET config var.
FRONTEND_URL=https://your-frontend.herokuapp.com
REVALIDATE_SECRET=generate_a_long_random_string

# Optional: Google Search Console site verification token (for the <meta name="google-site-verification"> tag).
# GOOGLE_SITE_VERIFICATION=

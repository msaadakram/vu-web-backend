# Server
PORT=5000
NODE_ENV=production

# MongoDB — use Atlas or another cloud-hosted MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/uni?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=90d

# CORS — your frontend domain
CLIENT_URL=https://your-frontend.vercel.app

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=uni-resources
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-your-bucket.r2.dev

# DigitalOcean GenAI (Serverless Inference)
DOAI_API_KEY=doo_v1_your-api-key
DOAI_BASE_URL=https://inference.do-ai.run/v1
DOAI_MODEL=deepseek-4-flash
DOAI_MAX_TOKENS=6000

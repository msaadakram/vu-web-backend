# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/vu-web

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=90d

# CORS — your frontend domain(s). Comma-separated.
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=885831892020-h65tdqhb181hppd20e2e8o6l9ha6rlbn.apps.googleusercontent.com
# NEVER commit the real secret. Add it only in Vercel/Heroku env vars.
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret_here

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# DigitalOcean GenAI
DOAI_API_KEY=doo_v1_your_api_key
DOAI_BASE_URL=https://inference.do-ai.run/v1
DOAI_MODEL=deepseek-4-flash
DOAI_MAX_TOKENS=6000

# On-demand frontend revalidation (optional)
FRONTEND_URL=https://your-frontend.vercel.app
REVALIDATE_SECRET=generate_a_long_random_string
